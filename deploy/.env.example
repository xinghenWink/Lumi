# Image selection; use a fixed release tag in production.
LUMI_IMAGE=ghcr.io/xinghenwink/lumi
LUMI_VERSION=v1.0.0
# Public origin for account CSRF validation, and display timezone.
PUBLIC_BASE_URL=http://127.0.0.1:8080
TZ=Asia/Shanghai
# Bind the application to this port inside the container.
HTTP_ADDR=:8080
APP_ENV=production
GIN_MODE=release
LOG_LEVEL=info
# Generate nonempty passwords before running the production compose stack.
POSTGRES_USER=lumi
POSTGRES_DB=lumi
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Optional full URLs override the compose-generated connection strings.
# DATABASE_URL=postgres://lumi:password@postgres:5432/lumi?sslmode=disable
# REDIS_URL=redis://:password@redis:6379/0
# Required for account services. Generate random keys; never commit actual values.
# JWT_SECRET: at least 32 random bytes (for example, openssl rand -hex 32).
JWT_SECRET=
# ENCRYPTION_KEY: exactly 32 bytes encoded in base64 (openssl rand -base64 32).
ENCRYPTION_KEY=
# Required on the first production start. Later changes do not reset the administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional environment overrides; nonempty values take precedence over saved settings.
# SITE_NAME=Lumi
# REGISTRATION_ENABLED=true
# EMAIL_VERIFICATION_ENABLED=true
# EMAIL_DOMAIN_ALLOWLIST=example.com
# EMAIL_DOMAIN_BLOCKLIST=blocked.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_ENCRYPTION=starttls
# Local Vite origin used for CSRF validation in development.
# DEV_ORIGIN=http://127.0.0.1:5173
# One-time recovery command input, only set when running admin reset-password.
# ADMIN_RESET_PASSWORD=
# Optional first-start channel and model bootstrap; leave both blank to configure in the UI.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
# Explicit permission for trusted self-hosted private-network channels and proxies.
UPSTREAM_ALLOW_PRIVATE_NETWORKS=false
DATA_DIR=/data
COOKIE_SECURE=false
# Public HTTPS deployments must set COOKIE_SECURE=true; false is accepted only for loopback HTTP.
# Trust only the actual reverse proxy source address (CIDR), never all networks.
TRUSTED_PROXIES=

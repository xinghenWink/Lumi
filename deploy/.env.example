# Image selection; use a fixed release tag after the first published release.
LUMI_IMAGE=ghcr.io/xinghenwink/lumi
LUMI_VERSION=edge
# Public URL and display timezone; consumed by later milestones.
PUBLIC_BASE_URL=http://localhost:8080
TZ=Asia/Shanghai
# Bind the application to this port inside the container.
HTTP_ADDR=:8080
APP_ENV=production
GIN_MODE=release
LOG_LEVEL=info
# Generate nonempty passwords before running the production compose stack.
POSTGRES_USER=lumi
POSTGRES_DB=lumi
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Optional full URLs override the compose-generated connection strings.
# DATABASE_URL=postgres://lumi:password@postgres:5432/lumi?sslmode=disable
# REDIS_URL=redis://:password@redis:6379/0
# Reserved for M1/M3; these values are not used by M0. Do not commit secrets.
JWT_SECRET=
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
DATA_DIR=/data
COOKIE_SECURE=false
TRUSTED_PROXIES=

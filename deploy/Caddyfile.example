# Replace the hostname; Caddy obtains and renews HTTPS certificates automatically.
lumi.example.com {
    request_body {
        max_size 30MB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
        header_up X-Forwarded-For {remote_host}
    }
}

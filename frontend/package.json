{
  "name": "@lumi/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:react": "vite --mode react --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "build:react": "tsc -p tsconfig.react.json && vite build --mode react",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.react.json",
    "test": "vitest run && vitest run --mode react",
    "test:e2e": "playwright test",
    "test:e2e:react": "playwright test --config playwright.react.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",

    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@tanstack/vue-virtual": "3.13.47",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "i18next": "26.5.7",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "lucide-vue-next": "0.577.0",
    "markdown-it": "15.0.3",
    "pinia": "3.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.5",
    "react-router-dom": "7.18.4",
    "reka-ui": "2.11.0",
    "shiki": "4.5.0",

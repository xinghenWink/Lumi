    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.19.7",
    "@types/react": "19.3.0",
